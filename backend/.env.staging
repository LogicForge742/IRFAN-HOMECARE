FLASK_ENV=production
APP_ENV=staging
SECRET_KEY=staging-secret-key-must-be-replaced
JWT_SECRET_KEY=staging-jwt-secret-key-must-be-replaced
DATABASE_URL=postgresql://irfan_staging_user:staging_password@postgres:5432/irfan_homecare_staging
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
MAIL_SERVER=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=apikey
MAIL_PASSWORD=staging_api_key
MAIL_DEFAULT_SENDER=Irfan HomeCare Staging <noreply@staging.irfanhomecare.com>
